{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiana-django-staging",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "ALLOWED_HOSTS": "tiana-django-staging.fosingkameni.workers.dev",
    "CSRF_TRUSTED_ORIGINS": "https://tiana-django-staging.fosingkameni.workers.dev",
    "SECURE_SSL_REDIRECT": "1"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tiana-django-media"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "74744f012eb646569c58b7659715ea80"
    }
  ],
  "observability": {"enabled": true}
}
