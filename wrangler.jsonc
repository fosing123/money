{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiana-django-staging",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "placement": {
    "region": "aws:eu-west-2"
  },
  "limits": {
    "cpu_ms": 60000
  },
  "vars": {
    "ALLOWED_HOSTS": "tiana-django-staging.fosingkameni.workers.dev,staging.tiana.lol,tiana.lol,www.tiana.lol",
    "CSRF_TRUSTED_ORIGINS": "https://tiana-django-staging.fosingkameni.workers.dev,https://staging.tiana.lol,https://tiana.lol,https://www.tiana.lol",
    "SECURE_SSL_REDIRECT": "1",
    "FIREBASE_WEB_VAPID_KEY": "BBribgqIk3PI0TDvioC34aAzlCOgpntHQRfSVCgMqqFaA2t27bM03GgQLJYlCWcBDsyi9BEcYavppOPJVk81Fgs",
    "FIREBASE_WEB_API_KEY": "AIzaSyACoGDU4MgYndo6ddPgruFC64kThnWfqwY",
    "FIREBASE_WEB_AUTH_DOMAIN": "tiana-9632c.firebaseapp.com",
    "FIREBASE_WEB_PROJECT_ID": "tiana-9632c",
    "FIREBASE_WEB_MESSAGING_SENDER_ID": "573252278637",
    "FIREBASE_WEB_APP_ID": "1:573252278637:web:b4c5a5600e0a87df5aa264"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tiana-django-media"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "74744f012eb646569c58b7659715ea80"
    }
  ],
  "observability": {
    "enabled": true
  },
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "django/contrib/**/static/**",
      "**/__pycache__/**",
      "**/*.pyi",
      "**/*.dist-info/**",
      "**/*.egg-info/**",
      "**/*.mo",
      "**/*.pot",
      "**/*.po",
      "**/*.md",
      "**/LICENSE*",
      "**/licenses/**",
      "**/tests/**",
      "**/test/**",
      "**/testing/**",
      "**/docs/**",
      "**/examples/**",
      "django/test/**",
      "django/contrib/gis/**",
      "django/contrib/admindocs/**",
      "django/contrib/flatpages/**",
      "django/contrib/redirects/**",
      "django/contrib/sitemaps/**",
      "django/contrib/postgres/**",
      "django/contrib/admin/static/**",
      "tzdata/zoneinfo/America/**",
      "tzdata/zoneinfo/Antarctica/**",
      "tzdata/zoneinfo/Arctic/**",
      "tzdata/zoneinfo/Asia/**",
      "tzdata/zoneinfo/Atlantic/**",
      "tzdata/zoneinfo/Australia/**",
      "tzdata/zoneinfo/Etc/**",
      "tzdata/zoneinfo/Europe/**",
      "tzdata/zoneinfo/Indian/**",
      "tzdata/zoneinfo/Pacific/**",
      "tzdata/zoneinfo/posix/**",
      "tzdata/zoneinfo/right/**",
      "PIL/AvifImagePlugin.py",
      "PIL/BdfFontFile.py",
      "PIL/BlpImagePlugin.py",
      "PIL/BufrStubImagePlugin.py",
      "PIL/CurImagePlugin.py",
      "PIL/DcxImagePlugin.py",
      "PIL/DdsImagePlugin.py",
      "PIL/EpsImagePlugin.py",
      "PIL/FitsImagePlugin.py",
      "PIL/FliImagePlugin.py",
      "PIL/FpxImagePlugin.py",
      "PIL/FtexImagePlugin.py",
      "PIL/GbrImagePlugin.py",
      "PIL/GdImageFile.py",
      "PIL/IcnsImagePlugin.py",
      "PIL/ImageQt.py",
      "PIL/ImageTk.py",
      "PIL/McIdasImagePlugin.py",
      "PIL/MicImagePlugin.py",
      "PIL/MpegImagePlugin.py",
      "PIL/MspImagePlugin.py",
      "PIL/PcdImagePlugin.py",
      "PIL/PcxImagePlugin.py",
      "PIL/PixarImagePlugin.py",
      "PIL/PsdImagePlugin.py",
      "PIL/QoiImagePlugin.py",
      "PIL/SgiImagePlugin.py",
      "PIL/SunImagePlugin.py",
      "PIL/TgaImagePlugin.py",
      "PIL/WmfImagePlugin.py",
      "PIL/XbmImagePlugin.py",
      "PIL/XpmImagePlugin.py",
      "PIL/XVThumbImagePlugin.py"
    ]
  }
}