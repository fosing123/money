# Copy to .env on the server. Never commit real values.
DEBUG=1
SECRET_KEY=change-me-before-deploy
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=0

# Recommended for production: PostgreSQL. Leave blank to use local SQLite in development.
DATABASE_URL=

# TIANA AI coach. The Gemini key stays on the server, never in browser JavaScript.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEFAULT_FROM_EMAIL=hello@tiana.app
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1