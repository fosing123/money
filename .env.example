# Copy to .env on the server; never commit real values.
DEBUG=1
SECRET_KEY=change-me-before-deploy
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://tiana-django-staging.<your-subdomain>.workers.dev
SECURE_SSL_REDIRECT=0
DB_CONN_MAX_AGE=60
DATABASE_URL=sqlite:///db.sqlite3
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Fill these only after AdSense approves TIANA and provides publisher/ad-unit IDs.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
DEFAULT_FROM_EMAIL=hello@tiana.app
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Firebase Cloud Messaging (server-side secret; never commit a service-account file)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Public Firebase Web app settings; safe to expose to the browser when domain-restricted.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# Cloudflare Worker production uses a Hyperdrive PostgreSQL binding and an R2 MEDIA binding.
# Do not put Hyperdrive credentials, service-account JSON or real secrets in this file.
